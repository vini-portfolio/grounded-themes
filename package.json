{
  "name": "grounded-themes",
  "version": "0.1.0",
  "private": true,
  "description": "On-device NLP pipeline that turns research notes into themes and shows its work.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/copy-ort.mjs && vite",
    "build": "node scripts/copy-ort.mjs && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check:weights": "node scripts/check-weights.mjs",
    "build:e2e": "node scripts/copy-ort.mjs && VITE_FAULT_HOOKS=1 vite build --outDir dist-e2e",
    "check:dist": "node scripts/check-dist.mjs",
    "check:data": "node scripts/check-data.mjs",
    "bench": "node scripts/bench.mjs",
    "bench:compare": "node scripts/bench-compare.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@vitest/coverage-v8": "5.1.2",
    "ajv": "8.20.0",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2"
  }
}
